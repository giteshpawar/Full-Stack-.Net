@model List<_16July_Assign.Models.Employee>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Employee Management System</h1>
    
</div>
<div>
<table border="1" cellpadding="10">

    <tr class="a">
        <th>Employee_id</th>
        <th>Employee_name</th>
        <th>Department</th>
        <th>Salary</th>
        <th>Email</th>
        
    </tr>




    @foreach (var item in Model)
    {

        <tr>
            <td><b>@item.Employee_id</b></td>
            <td><b>@item.Employee_name</b></td>
            <td><b>@item.Department</b></td>
            <td><b>@item.Salary</b></td>
            <td><b>@item.Email</b></td>
        </tr>

    }
    </table>
    </div>
